FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{

    inlet
    {
        type            totalPressure;
	p0		uniform 293842.5;
        value           uniform 293842.5;
    }

    outlet
    {
        type            waveTransmissive;
	gamma		1.4;
	value		uniform 101325;
	
    }

    symmetry
    {
        type            symmetry;
    }
    
    wall
    {
	type 		zeroGradient;
    }

    frontAndBackPlanes
    {
        type            empty;
    }
}


