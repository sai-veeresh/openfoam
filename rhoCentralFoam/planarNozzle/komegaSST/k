FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.5;

boundaryField
{

    inlet
    {
        type            fixedValue;
	value		uniform 1.5;
    }

    outlet
    {
        type            inletOutlet;
	inletValue	uniform 1.5;
	value		uniform 1.5;
    }

    symmetry
    {
        type            symmetry;
    }
    
    wall
    {
	type 		kqRWallFunction;
	value		uniform 1.5;
    }

    frontAndBackPlanes
    {
        type            empty;
    }
}


